# Step 4 of the guide: one line per key. Copy this file to .env on the computer or server where the AI agent runs.
# Never commit .env, never paste a key on a card or in chat. Leave a line empty if your setup does not use it.

# Step 2. Board: the private repository that holds the cards.
GITHUB_REPO=owner/name
# Step 2. GitHub App for the AI agent: it reads and writes cards in this one repository and nothing else. Every setup.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_PATH=

# Contact data: the AI agent looks up size, industry and country of every company, and builds the list in setup 1. Every setup.
APOLLO_API_KEY=
# Email verification: the AI agent checks every address before a send. Setup 1.
ZEROBOUNCE_API_KEY=
# Sending service: the AI agent loads the list and sequence, reads replies, answers in the thread. Setup 1.
SMARTLEAD_API_KEY=
# All-in-one outbound: the AI agent reads replies and answers from its mailbox. Setup 2.
EXPLEE_API_KEY=

# Mailbox for sign-ups: the AI agent writes from the sales rep's or a shared address. Setup 3.
MAILBOX_PROVIDER=            # google | microsoft | unipile
# Unipile connects Gmail and Outlook accounts through one API. Setup 3, only if MAILBOX_PROVIDER=unipile.
UNIPILE_DSN=
UNIPILE_API_KEY=
UNIPILE_ACCOUNT_ID=

# CRM: the AI agent checks for a customer or an active deal, and creates the lead before the first email. Every setup.
CRM=                         # hubspot | pipedrive
HUBSPOT_TOKEN=
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_DOMAIN=

# Calendar: the AI agent reads new bookings on every run and matches them to cards. Every setup.
CALENDLY_TOKEN=
# Short links: one tracked link per lead and material; the AI agent reads whether it was opened. Every setup.
SHORTIO_API_KEY=
SHORTIO_DOMAIN=

# Slack: the AI agent posts cards, alarms and (team mode) drafts for approval through a Slack app. Team mode and alarms.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_CARDS=
SLACK_CHANNEL_ALARMS=
SLACK_CHANNEL_APPROVALS=

# Sign-ups feed: the webhook secret or the mailbox that receives your product's notification email. Setup 3.
SIGNUP_WEBHOOK_SECRET=
SIGNUP_NOTIFICATION_MAILBOX=
# Your own company domains, separated by commas. Sign-ups from them are test accounts and get no email. Setup 3.
SIGNUP_OWN_DOMAINS=

# 1 means a dry run, a practice run: the scripts read sample data files from scripts/fixtures/ and write nothing. Set to 0 only when you mean it.
DRY_RUN=1
